# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# PostgreSQL
DATABASE_URL=postgres://snaplink:snaplink@localhost:5432/snaplink
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# AWS
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566  # LocalStack

# DynamoDB
DYNAMODB_TABLE=snaplink-links-dev

# SQS
SQS_QUEUE_URL=http://localhost:4566/000000000000/snaplink-analytics
SQS_DLQ_URL=http://localhost:4566/000000000000/snaplink-analytics-dlq

# S3
S3_BUCKET=snaplink-exports-dev

# Monitoring
SENTRY_DSN=
```

---

# 📄 File 7: `docker-compose.yml`

````yaml
version: "3.9"

services:
  postgres:
    image: postgres:15-alpine
    ports:
      - "5432:5432"
    environment:
      POSTGRES_USER: snaplink
      POSTGRES_PASSWORD: snaplink
      POSTGRES_DB: snaplink
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U snaplink"]
      interval: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    command: redis-server --appendonly yes
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s

  localstack:
    image: localstack/localstack:latest
    ports:
      - "4566:4566"
    environment:
      SERVICES: dynamodb,sqs,s3,lambda,apigateway,cloudwatch,secretsmanager
      DEBUG: 1
      DATA_DIR: /tmp/localstack/data
    volumes:
      - localstack_data:/tmp/localstack
      - /var/run/docker.sock:/var/run/docker.sock

  mailhog:
    image: mailhog/mailhog:latest
    ports:
      - "1025:1025"  # SMTP
      - "8025:8025"  # Web UI

volumes:
  postgres_data:
  redis_data:
  localstack_data: